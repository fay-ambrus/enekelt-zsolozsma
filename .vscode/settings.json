{
  // Documents live in zsolozsmas-konyvek/, vetitesek/ and egyeb-kiadvanyok/,
  // but every shared source is at the repository root: styles.tex,
  // ordo-cantus-officii/, the two chant packages and fonts/. So the search
  // paths use %WORKSPACE_FOLDER%, not %DIR%, which is now a subfolder.
  // OSFONTDIR is required: fontspec resolves GuidoHU.ttf and Cambria through
  // it, never through TEXINPUTS.
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex-unix",
      "command": "lualatex",
      "args": [
        "--shell-escape",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "TEXINPUTS": "%WORKSPACE_FOLDER%:%WORKSPACE_FOLDER%/gregosheet:%WORKSPACE_FOLDER%/gregosheet-psalm:",
        "LUAINPUTS": "%WORKSPACE_FOLDER%:%WORKSPACE_FOLDER%/gregosheet:%WORKSPACE_FOLDER%/gregosheet-psalm:",
        "OSFONTDIR": "%WORKSPACE_FOLDER%/fonts"
      }
    },
    {
      "name": "lualatex-win",
      "command": "cmd",
      "args": [
        "/c",
        "set TEXINPUTS=%WORKSPACE_FOLDER%\\;%WORKSPACE_FOLDER%\\gregosheet\\;%WORKSPACE_FOLDER%\\gregosheet-psalm\\;&& set LUAINPUTS=%WORKSPACE_FOLDER%\\;%WORKSPACE_FOLDER%\\gregosheet\\;%WORKSPACE_FOLDER%\\gregosheet-psalm\\;&& set OSFONTDIR=%WORKSPACE_FOLDER%\\fonts&& cd /d %OUTDIR% && lualatex --shell-escape -interaction=nonstopmode -synctex=1 %DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "LuaLaTeX (macOS/Linux)",
      "tools": ["lualatex-unix"]
    },
    {
      "name": "LuaLaTeX (Windows)",
      "tools": ["lualatex-win"]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "onSave",
  // One shared out/ at the root, so reprint.py keeps finding the PDFs and the
  // committed output stays in place.
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/out"
}
